# file location: repo root
# This should take precedence over ~/.editorconfig for all files in this repo.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
tab_width = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

# Markdown -- trailing whitespace is semantically significant (two spaces = <br>), so do
# not trim it. Indentation in Markdown is structural (code fences, lists), not a style
# choice, so leave indent_size unset. All other [*] defaults apply.
[*.md]
trim_trailing_whitespace = false
indent_size = unset

# TOML (.mise.toml)
[*.toml]
indent_size = 2

# YAML (.rubocop.yml)
[*.{yml,yaml}]
indent_size = 2

# gitignore/gitattributes -- columns of patterns use alignment spaces, not indentation
[{.gitignore,.gitattributes,**/.gitignore,**/.gitattributes}]
indent_size = unset
